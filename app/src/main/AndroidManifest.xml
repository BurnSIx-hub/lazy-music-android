<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Фоновое проигрывание с уведомлением -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Обновление с GitHub: APK ставит системный установщик, с согласия человека -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Lazy Music"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- singleTask: ссылка из браузера приходит в уже открытое приложение,
             а не второй его копией внутри браузера -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- lazymusic://play/<id>?t=…&a=… — со страницы-переходника (кнопка
                 в Discord, «Поделиться»): трек открывается здесь, а не на YouTube -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lazymusic" android:host="play" />
            </intent-filter>
        </activity>

        <!-- Забор понравившегося из YouTube Music: свой браузер со своим
             входом. Снаружи его не открыть; поворот экрана переживает сам,
             иначе страница и вход начинались бы заново -->
        <activity
            android:name=".YtMusicActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Проигрывание переживает закрытие активности; уведомление
             с кнопками система строит сама по MediaSession. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Ответ установщика при обновлении: окно подтверждения или отказ -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Сохранённый трек на старых Android лежит в папке приложения;
             открыть его другим плеером можно только через провайдер -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
