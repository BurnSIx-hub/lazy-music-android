<?xml version="1.0" encoding="utf-8"?>
<!--
  Обычный HTTP нужен ровно для одного: сводки с Lazy Music на компьютере
  в домашней сети (Hub.kt). Адрес компьютера заранее не известен, а
  сертификата для адреса в локальной сети не бывает — https там невозможен.
  Без этого Android с версии 9 молча обрывает такие запросы, и телефон
  «не находит» компьютер, хотя порт открыт (поймано 2026-10-15).
  Всё остальное приложение ходит по https — это задано самими адресами.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
